  "policies": [
    {
      "cmd": "ALL",
      "qual": "(user_id = auth.uid())",
      "roles": [
        "authenticated"
      ],
      "tablename": "profiles",
      "permissive": "PERMISSIVE",
      "policyname": "users manage own profile",
      "schemaname": "public",
      "with_check": "(user_id = auth.uid())"
    }
  ],
  "triggers": [
    "CREATE TRIGGER on_auth_user_created AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION handle_new_user()"
  ],
  "constraints": [
    "CHECK (((diet_type IS NULL) OR (diet_type = ANY (ARRAY['Veg'::text, 'Nonveg'::text, 'Vegan'::text, 'Eggetarian'::text]))))",
    "PRIMARY KEY (user_id)",
    "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
  ],
  "signup_function": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n  insert into public.profiles (\r\n    user_id,\r\n    display_name,\r\n    onboarding_complete\r\n  )\r\n  values (\r\n    new.id,\r\n    coalesce(\r\n      new.raw_user_meta_data->>'display_name',\r\n      new.email\r\n    ),\r\n    false\r\n  );\r\n\r\n  return new;\r\nend;\r\n$function$\n",
  "training_tables": [
    "workout_sessions",
    "workout_session_sets",
    "workout_alternative_mappings"
  ]
}
